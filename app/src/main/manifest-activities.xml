<!--
  PASTE THIS INSIDE the <application> ... </application> tag of app/src/main/AndroidManifest.xml.
  First DELETE the <activity android:name=".MainActivity" ...> block that Android Studio created
  (it has the MAIN / LAUNCHER intent-filter), then paste everything below.
-->

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".QueueActivity" android:exported="false" />
        <activity android:name=".SubmitJobActivity" android:exported="false" />
        <activity android:name=".MyJobsActivity" android:exported="false" />
        <activity android:name=".HistoryActivity" android:exported="false" />
        <activity android:name=".JobDetailsActivity" android:exported="false" />
